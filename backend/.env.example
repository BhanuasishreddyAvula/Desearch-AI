APP_NAME="Desearch AI Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api/v1"

# Supabase Credentials
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Groq Cloud API (Tier-1 Primary Ultra-Fast Provider)
# Get free API key at: https://console.groq.com (14,400 free requests/day)
GROQ_API_KEY="gsk_your-groq-api-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_DEFAULT_MODEL="llama-3.3-70b-versatile"

# OpenRouter LLM Settings (Tier-3 Tertiary Provider)
LLM_PROVIDER="groq"
LLM_MODEL="llama-3.3-70b-versatile"
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# NVIDIA NIM API (Tier-2 High-Availability Failover Provider)
# Get free credits & API key at: https://build.nvidia.com
NVIDIA_API_KEY="nvapi-your-nvidia-api-key"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_DEFAULT_MODEL="meta/llama-3.3-70b-instruct"
TIMEOUT_SECONDS=60

# Search & Content Tool Provider Settings
EXA_API_KEY="your-exa-api-key"
FIRECRAWL_API_KEY="your-firecrawl-api-key"
EXA_BASE_URL="https://api.exa.ai"
FIRECRAWL_BASE_URL="https://api.firecrawl.dev"
SEARCH_TIMEOUT=30
CONTENT_TIMEOUT=30

# Research Context Budgeting
RESEARCH_MAX_SOURCE_CHARS=10000
RESEARCH_MAX_TOTAL_CHARS=40000

LOG_LEVEL="INFO"
