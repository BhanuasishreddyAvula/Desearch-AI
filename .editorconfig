# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
indent_style = space

[*.{js,jsx,ts,tsx,json,jsonc}]
indent_size = 2
indent_style = space

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.md]
insert_final_newline = true
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf
indent_size = 2
indent_style = space

[*.{bat,cmd,ps1}]
end_of_line = crlf
