# ==============================================================================
# Desearch AI — Master Environment Configuration Example
# Copy this file to '.env' and fill in values. NEVER commit '.env' to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings (app.py)
# ------------------------------------------------------------------------------
APP_NAME="Desearch AI Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"                       # Options: development, testing, staging, production
DEBUG=true
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Security Settings (security.py)
# ------------------------------------------------------------------------------
SECRET_KEY="change_this_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
API_KEY_SECRET="change_this_api_key_secret_in_production"

# ------------------------------------------------------------------------------
# Supabase & Database Settings (supabase.py)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_placeholder"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_placeholder"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/desearch_ai"

# ------------------------------------------------------------------------------
# LLM Settings (llm.py)
# ------------------------------------------------------------------------------
LLM_PROVIDER="gemini"                            # Options: gemini, openai, anthropic, mock
LLM_MODEL="gemini-1.5-flash"
API_KEY="your_llm_api_key_placeholder"
TEMPERATURE=0.2
MAX_TOKENS=4096
TIMEOUT_SECONDS=30
MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Redis Settings (redis.py)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL=3600
RATE_LIMIT_WINDOW=60

# ------------------------------------------------------------------------------
# Observability Settings (observability.py)
# ------------------------------------------------------------------------------
LOG_LEVEL="INFO"                                # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="json"                               # Options: json, text
ENABLE_METRICS=false
ENABLE_TRACING=true
