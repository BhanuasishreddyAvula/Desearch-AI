# ==============================================================================
# Desearch AI — Master Environment Configuration Example
# Copy this file to '.env' and fill in values. NEVER commit '.env' to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME="Desearch AI Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"                       # Options: development, testing, staging, production
DEBUG=true
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------------------------
SECRET_KEY="change_this_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
API_KEY_SECRET="change_this_api_key_secret_in_production"

# ------------------------------------------------------------------------------
# Supabase Credentials & Persistence
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# Groq Cloud API (Tier-1 Primary Ultra-Fast Provider — 14,400 free requests/day)
# Get free API key at: https://console.groq.com
# ------------------------------------------------------------------------------
GROQ_API_KEY="gsk_your-groq-api-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_DEFAULT_MODEL="llama-3.3-70b-versatile"

# ------------------------------------------------------------------------------
# OpenRouter LLM Settings (Tier-3 Tertiary Provider)
# ------------------------------------------------------------------------------
LLM_PROVIDER="groq"                              # Active LLM provider
LLM_MODEL="llama-3.3-70b-versatile"              # Active LLM model
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ------------------------------------------------------------------------------
# NVIDIA NIM API (Tier-2 High-Availability Secondary Failover Provider)
# Get free credits & API key at: https://build.nvidia.com
# ------------------------------------------------------------------------------
NVIDIA_API_KEY="nvapi-your-nvidia-api-key"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_DEFAULT_MODEL="meta/llama-3.3-70b-instruct"

TEMPERATURE=0.2
MAX_TOKENS=4096
TIMEOUT_SECONDS=60
MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Search & Content Extraction Tools
# ------------------------------------------------------------------------------
EXA_API_KEY="your-exa-api-key"
FIRECRAWL_API_KEY="your-firecrawl-api-key"
EXA_BASE_URL="https://api.exa.ai"
FIRECRAWL_BASE_URL="https://api.firecrawl.dev"
SEARCH_TIMEOUT=30
CONTENT_TIMEOUT=30

# ------------------------------------------------------------------------------
# Research Context Budgeting & Deduplication
# ------------------------------------------------------------------------------
RESEARCH_MAX_SOURCE_CHARS=10000
RESEARCH_MAX_TOTAL_CHARS=40000

# ------------------------------------------------------------------------------
# Observability Settings
# ------------------------------------------------------------------------------
LOG_LEVEL="INFO"                                # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
