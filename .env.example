# ==============================================================================
# Desearch AI — Environment Configuration Example
# Copy this file to '.env' and fill in real values. NEVER commit '.env' to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# System & General Configuration
# ------------------------------------------------------------------------------
APP_NAME="Desearch AI"
APP_ENV=development                            # Options: development, staging, production
DEBUG=true
PORT=8000

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
API_KEY_SECRET=your_api_key_secret_placeholder
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# Frontend Service Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ENABLE_TRACE_VIEWER=true

# ------------------------------------------------------------------------------
# Database & Persistence (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/desearch_ai
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder

# ------------------------------------------------------------------------------
# LLM Provider Integration
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini                             # Options: gemini, openai, anthropic
LLM_API_KEY=your_llm_api_key_placeholder
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# External Research Tools
# ------------------------------------------------------------------------------
WEB_SEARCH_API_KEY=your_web_search_api_key_placeholder
MAX_TOOL_INVOCATIONS_RESEARCH=5
MAX_TOOL_INVOCATIONS_FACT_CHECK=3

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                                  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                                 # Options: json, text
ENABLE_EXECUTION_TRACING=true
